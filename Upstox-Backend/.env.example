# ── Add these to your existing .env ──────────────────────────────────────────

# Redis connection URL (default: local Redis on port 6379)
REDIS_URL=redis://127.0.0.1:6379

# URL that consumer services use to reach the feed service REST API
FEED_API_URL=http://localhost:4141

# (Existing — keep as-is)
# MONGO_URI=mongodb://...
# PORT_4141=4141
# SUBSCRIPTIONS_FILE=subscriptions.json
